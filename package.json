{
    "name": "kuroshiro-analyzer-seed",
    "version": "2.0.0-beta.1",
    "description": "seed/example for building morphological analyzer",
    "main": "index.js",
    "module": "src/index.js",
    "scripts": {
        "lint": "eslint src test scripts index.js *.mjs *.cjs",
        "lint:fix": "npm run lint -- --fix",
        "jest": "jest --verbose",
        "jest:watch": "npm run jest -- --watch",
        "jest:coverage": "jest --verbose --coverage",
        "test:package": "node test/package-smoke.cjs",
        "test:joint": "node test/joint.cjs",
        "test": "npm run lint && npm run jest && npm run build && npm run test:package && npm run test:types && npm run test:joint",
        "clean": "rimraf lib dist",
        "build": "npm run clean && npm run build:cjs && npm run build:browser && npm run build:browser:min",
        "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir lib",
        "prepack": "npm run build",
        "test:types": "tsc --project tsconfig.json && node test/types.cjs",
        "build:browser": "vite build",
        "build:browser:min": "vite build --mode minify"
    },
    "keywords": [
        "kuroshiro",
        "analyzer",
        "seed"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/hexenq/kuroshiro-analyzer-seed.git"
    },
    "author": "Hexen Qi",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/hexenq/kuroshiro-analyzer-seed/issues"
    },
    "homepage": "https://github.com/hexenq/kuroshiro-analyzer-seed",
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "acorn": "^8.18.0",
        "babel-jest": "^30.5.1",
        "babel-plugin-add-module-exports": "^1.0.4",
        "cross-env": "^10.1.0",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "jest": "^30.5.1",
        "jest-environment-jsdom": "^30.5.1",
        "jsdom": "^26.1.0",
        "kuroshiro": "^1.2.0",
        "rimraf": "^6.1.3",
        "typescript": "7.0.2",
        "vite": "^8.3.0"
    },
    "files": [
        "index.js",
        "index.d.ts",
        "src",
        "lib",
        "dist"
    ],
    "types": "index.d.ts",
    "browser": "dist/kuroshiro-analyzer-seed.mjs",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "tag": "beta"
    }
}
